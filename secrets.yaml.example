# Vorlage: kopiere diese Datei nach secrets.yaml und trage deine eigenen Werte ein.
# secrets.yaml gehört NICHT ins Git-Repository (steht in .gitignore).

wifi_ssid: "MeinWLAN"
wifi_password: "MeinWLANPasswort"
ap_password: "FallbackPasswort"            # mindestens 8 Zeichen
ota_password: "OtaPasswort"

# Verschlüsselungs-Key der Home-Assistant-API (32 Byte, Base64). Neu erzeugen mit: esphome wizard
# oder: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
api_key: "MFGEFasSk2ePiv/8vpbu4EGIQ+o9Dr3/X5F6QZLqQXA="

mqtt_broker: "192.168.0.10"
mqtt_user: "mqtt-benutzer"
mqtt_password: "mqtt-passwort"

# AES-Key deines Zählers (32 Hex-Zeichen), den du vom Netzbetreiber erhalten hast.
# Dies ist nur ein Platzhalter und funktioniert mit keinem echten Zähler.
amis_aes_key: "00112233445566778899AABBCCDDEEFF"
